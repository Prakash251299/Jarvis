# Jarvis AI Assistant - Backend Environment Configuration
# Copy this file to .env and customize values

# Application
APP_NAME="Jarvis AI Assistant"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120.0

# Speech-to-Text (Faster-Whisper)
# Options: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=base
# Options: cpu, cuda, auto
WHISPER_DEVICE=cpu
# Options: int8, float16, float32 (int8 recommended for CPU)
WHISPER_COMPUTE_TYPE=int8

# Text-to-Speech (Piper)
PIPER_VOICE=en_US-lessac-medium
PIPER_DATA_DIR=~/.local/share/piper

# Memory
MEMORY_CONTEXT_WINDOW=10
MAX_CONVERSATION_HISTORY=20

CORS_ORIGINS=["*"]
